{
  "expo": {
    "name": "intava",
    "slug": "Intava",
    "version": "1.4.0",
    "scheme": "intava",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17171C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intava.app",
      "appleTeamId": "9A66V5LDFK",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "workout-processing"
        ],
        "NSHealthShareUsageDescription": "인타바는 건강 데이터를 읽지 않습니다.",
        "NSHealthUpdateUsageDescription": "운동 중 iOS 운동 세션을 켜서 잠금화면·다이내믹 아일랜드 타이머를 이어 갑니다.",
        "UIUserInterfaceStyle": "Dark",
        "CFBundleLocalizations": [
          "ko",
          "en",
          "ja",
          "zh-Hans"
        ],
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryAddUsageDescription": "운동 기록 카드를 사진 앱에 저장합니다."
      }
    },
    "android": {
      "package": "com.intava.app",
      "versionCode": 2,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#17171D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      "./plugins/withFreshPodResources",
      "expo-router",
      "expo-system-ui",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#17171C"
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/cue.wav",
            "./assets/sounds/work.wav",
            "./assets/sounds/rest.wav",
            "./assets/sounds/block.wav",
            "./assets/sounds/round.wav",
            "./assets/sounds/cooldown.wav",
            "./assets/sounds/done.wav"
          ]
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/league-spartan/600SemiBold/LeagueSpartan_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/league-spartan/700Bold/LeagueSpartan_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.intava.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.intava.app",
          "enablePushNotifications": false,
          "widgets": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "defcb786-3397-4794-8bf4-aedc581c9e27"
      }
    },
    "owner": "yunuchoiii"
  }
}
